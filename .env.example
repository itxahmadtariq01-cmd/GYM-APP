# Copy to .env for a production deployment and replace every placeholder.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-unique-secret-before-deployment
DJANGO_ALLOWED_HOSTS=gym.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://gym.example.com
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# Enable only when TLS terminates at a trusted proxy that overwrites this header.
DJANGO_TRUST_X_FORWARDED_PROTO=True
DATABASE_URL=postgresql://gym_user:replace-me@db.example.com:5432/caliber_labs

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=Caliber Labs <no-reply@gym.example.com>

GOOGLE_API_KEY=replace-me
